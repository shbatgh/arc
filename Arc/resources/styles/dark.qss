/* Global Defaults */
* {
    color: #D4D4D4;
    font-family: "Inter", "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 13px;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
    outline: none; /* Removes dotted focus rect */
}

/* Main Window & Backgrounds */
QMainWindow, QDialog {
    background-color: #1E1E1E;
}

QWidget {
    background-color: #1E1E1E;
}

/* Sidebar & Panels */
/* Assuming Sidebar is a QWidget inside QMainWindow, we give it a slightly lighter bg */
QWidget#Sidebar, QWidget#Timeline {
    background-color: #252526;
    border-left: 1px solid #3E3E42;
}

/* Typography headers */
QLabel#SidebarTitle {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #858585; /* Muted subtitle style */
    padding-bottom: 6px;
    letter-spacing: 0.5px;
}

QLabel#TimelineTimepointLabel {
    color: #4EC9B0; /* Soft Teal Accent */
    font-weight: 700;
    font-size: 14px;
}

/* Buttons */
QPushButton {
    background-color: #3C3C3C;
    border: none;
    border-radius: 4px;
    color: #CCCCCC;
    padding: 6px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #4A4A4A;
}

QPushButton:pressed {
    background-color: #2D2D2D;
    padding-top: 7px; /* Subtle press effect */
    padding-bottom: 5px;
}

QPushButton:disabled {
    background-color: #2D2D2D;
    color: #6E6E6E;
}

/* Menus */
QMenuBar {
    background-color: #1E1E1E;
    border-bottom: 1px solid #333333;
}

QMenuBar::item {
    padding: 6px 10px;
    background: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #333333;
}

QMenu {
    background-color: #252526;
    border: 1px solid #454545;
    padding: 4px;
    border-radius: 6px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #094771; /* VS Code Blue selection */
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background: #454545;
    margin: 4px 0px;
}

/* Sliders */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #3E3E42;
    margin: 2px 0;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #CCCCCC;
    border: none;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #FFFFFF;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #007ACC; /* Primary Accent Color */
    border-radius: 2px;
}

/* Tables (for Properties) */
QTableWidget {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    gridline-color: #3E3E42;
}

QHeaderView::section {
    background-color: #2D2D2D;
    color: #CCCCCC;
    padding: 4px;
    border: none;
    border-bottom: 1px solid #3E3E42;
    border-right: 1px solid #3E3E42;
    font-weight: 600;
}

QTableWidget::item {
    padding: 4px;
    border-bottom: 1px solid #303030; /* Subtle row separator */
}

QTableWidget::item:selected {
    background-color: #37373D;
    color: #FFFFFF;
}

/* Scrollbars - Minimalist */
QScrollBar:vertical {
    border: none;
    background: #1E1E1E;
    width: 10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #424242;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #4F4F4F;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Status Bar */
QStatusBar {
    background-color: #007ACC; /* Accent Color Bar */
    color: #FFFFFF;
    font-weight: 600;
}

QStatusBar::item {
    border: none;
}